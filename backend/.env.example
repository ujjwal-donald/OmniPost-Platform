# ============================================================
# AI Content Creator backend — environment configuration
# Copy to .env and fill in. The app REFUSES TO BOOT on missing
# or invalid values (fail-fast).
# ============================================================

ENVIRONMENT=development
DEBUG=true
COOKIE_SECURE=false            # true in staging/production (HTTPS only)

# --- Database (PostgreSQL 16, asyncpg driver required) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_content

# --- Redis (Celery broker + rate limiting) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- OAuth token encryption at rest ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=CHANGE_ME

# --- CORS (JSON list of exact origins; NEVER *) ---
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Frontend (OAuth callbacks redirect back here) ---
FRONTEND_URL=http://localhost:5173

# --- Meta (Facebook / Instagram) ---
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
META_REDIRECT_URI=http://localhost:8000/api/v1/social/callback/facebook

# --- LinkedIn (Phase 2 OAuth; adapter supports text posts) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Media storage ---
# local = dev only. s3 is REQUIRED for real Facebook/Instagram photo
# publishing (Meta downloads media by public URL).
STORAGE_BACKEND=local
S3_BUCKET=ai-content-media
S3_REGION=auto
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
MAX_IMAGE_SIZE_MB=25
MAX_VIDEO_SIZE_MB=100

# --- Reverse proxy ---
# Set true ONLY behind a proxy you control that overwrites X-Forwarded-For.
TRUST_X_FORWARDED_FOR=false
TRUSTED_PROXY_COUNT=1
MAX_MEDIA_PER_POST=10
